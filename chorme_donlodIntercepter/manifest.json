{
    "manifest_version": 3,
    "name": "Auto Downloader",
    "version": "1.0.0",
    "description": "Intelligent download interceptor that uses multi-threaded downloads for large files",
    "permissions": [
        "downloads",
        "nativeMessaging",
        "storage",
        "notifications"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        },
        "default_title": "Auto Downloader"
    }
}